chcp 65001 >nul
@echo off
rem 启动 Castalia 联邦托盘（AIRI / Hermes / LobeHub 共用，仅一个图标）
rem 关键: 清 PYTHONPATH 污染 + start 脱离会话

set PYTHONPATH=
start "" "C:\Users\yuepengcheng\AppData\Local\Programs\Python\Python310\pythonw.exe" "D:\AI\castalia\run\Castalia\scripts\castalia_tray.py"

rem 等待并确认（ping 延时兼容非交互环境）
ping -n 4 127.0.0.1 >nul
tasklist /fi "imagename eq pythonw.exe" 2>nul | findstr /i pythonw >nul
if %errorlevel% equ 0 (
    echo.
    echo   Castalia 联邦托盘已启动，请看右下角系统托盘（青绿星标）
    echo   左键打开联邦总图；各端自己的星图在右键「打开」里
) else (
    echo.
    echo   [WARN] 未检测到 pythonw 进程，请查看日志:
    echo   D:\AI\castalia\run\Castalia\scripts\castalia-tray.log
)
echo.
ping -n 3 127.0.0.1 >nul
exit
