chcp 65001 >nul
@echo off
title AIRI Launcher
rem --- 清除 PYTHONPATH 污染（Hermes 注入的 venv 路径会让 Python310 加载错误的二进制） ---
set PYTHONPATH=

echo ========================================
echo   Starting AIRI + Memory + Embed
echo ========================================
echo.
rem --- [1/3] Castalia 共用嵌入 :11436（已在跑则复用，不再拉 11435） ---
echo [1/3] Yuan-EB embed :11436
set OLLAMA_URL=http://127.0.0.1:11436
netstat -ano | findstr ":11436" | findstr "LISTENING" >nul
if %errorlevel% neq 0 (
    start "YuanEmbed" "C:/Users/yuepengcheng/AppData/Local/Programs/Python/Python310/pythonw.exe" "D:/AI/castalia/run/Castalia/yuan_embed_server.py" 11436
    echo       已启动 Castalia 嵌入
    timeout /t 4 /nobreak >nul
) else (
    echo       已在运行，复用
)
for /f "tokens=5" %%a in ('netstat -ano ^| findstr ":11435" ^| findstr "LISTENING"') do (
    echo       清理旧端口 11435 PID %%a
    taskkill /f /pid %%a 2>nul
)
rem --- [2/3] Start AIRI Unified Proxy (LLM + TTS + Memory, 无窗口) ---
echo [2/3] Starting AIRI Unified Proxy...
rem Kill any existing process on 5050
for /f "tokens=5" %%a in ('netstat -ano ^| findstr ":5050" ^| findstr "LISTENING"') do (
    taskkill /f /pid %%a 2>nul
)
timeout /t 1 /nobreak >nul
set REALTIME_CLASSIFY=1
set LLM_UPSTREAM=https://api.deepseek.com/v1
set ANIMA_DIR=D:\AI\castalia\run\Castalia-Anima
set NODE_BIN=D:\system\New Folder\node.exe
set OLLAMA_URL=http://127.0.0.1:11436
set FEDERATION_DIRS=[{"name":"Hermes","dir":"D:/AI/castalia/memory-banks/hermes"},{"name":"LobeHub","dir":"D:/AI/castalia/memory-banks/lobehub"},{"name":"AIRI","dir":"D:/AI/castalia/memory-banks/airi"}]
start "AIRI-Proxy" "C:/Users/yuepengcheng/AppData/Local/Programs/Python/Python310/pythonw.exe" "D:/system/AIRI/unified-proxy/proxy.py"
echo       Waiting for proxy...
timeout /t 8 /nobreak >nul
rem --- [3/3] Start AIRI ---
echo [3/3] Starting AIRI...
start "" "D:/system/AIRI/airi.exe"

echo.
echo ========================================
echo   All started!
echo   Embed:       http://127.0.0.1:11436 (Yuan-EB 2.0-zh, 共用)
echo   AIRI Proxy:  http://127.0.0.1:5050
echo   Memory MCP:  castalia\run\Castalia-Anima dist/index.js (via memory_engine)
echo   LLM:         https://api.deepseek.com/v1
echo   Logs:        D:\system\AIRI\unified-proxy\unified-proxy.log
echo ========================================
echo.
timeout /t 3 /nobreak >nul
exit
